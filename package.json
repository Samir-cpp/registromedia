{
  "name": "registromedia",
  "version": "1.0.1",
  "private": true,
  "description": "Votiva: voti e medie, offline e personali",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:desktop": "electron . --smoke-test",
    "dist:win:portable": "electron-builder --win zip --x64 --publish never --config.win.signAndEditExecutable=false",
    "android:assets": "node scripts/android-assets.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "dist:web": "node scripts/web-assets.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "it.registromedia.app",
    "productName": "Votiva",
    "files": [
      "index.html",
      "style.css",
      "app.mjs",
      "model.mjs",
      "vault.mjs",
      "desktop/**",
      "icon.svg",
      "package.json",
      "manifest.json",
      "theme.js",
      "icon-192.png",
      "icon-512.png",
      "apple-touch-icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "artifactName": "Votiva-${version}-${arch}-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Votiva"
    }
  },
  "author": "RegistroMedia",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  }
}
